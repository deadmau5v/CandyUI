{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Gartic Show inspired web-game energy, rounded toy-like controls and original CandyUI artwork.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.765, 0.933],
        "hex": "#00c3ee"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.039, 0.686, 0.949],
        "hex": "#0aaff2"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.796, 0.02],
        "hex": "#ffcb05"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.031, 0.169, 0.294],
        "hex": "#082b4b"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.09, 0.239, 0.365],
        "hex": "#173d5d"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.325, 0.431, 0.51],
        "hex": "#536e82"
      }
    },
    "heroTitle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.965, 0.643, 0.027],
        "hex": "#f6a407"
      }
    },
    "heroPattern": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.702, 0.875],
        "hex": "#00b3df"
      }
    },
    "surfaceTint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.937, 0.969, 0.992],
        "hex": "#eff7fd"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.796, 0.867, 0.914],
        "hex": "#cbdde9"
      }
    },
    "green": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.439, 0.851, 0.592],
        "hex": "#70d997"
      }
    },
    "pink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.969, 0.502, 0.682],
        "hex": "#f780ae"
      }
    },
    "purple": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.475, 0.333, 0.78],
        "hex": "#7955c7"
      }
    },
    "purpleInk": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.231, 0.145, 0.38],
        "hex": "#3b2561"
      }
    },
    "highlight": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.957, 0.722],
        "hex": "#fff4b8"
      }
    },
    "blueStrong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.09, 0.38, 0.82],
        "hex": "#1761d1"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 72,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 30,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fredoka",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fredoka",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fredoka",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fredoka",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fredoka",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fredoka",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
